# --- Base de datos ---
# En local: el PostgreSQL de docker-compose.
# En Vercel: la cadena "pooled" de Neon (host con -pooler), p. ej.
#   postgresql://usuario:clave@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://fitoprice:fitoprice@localhost:5434/fitoprice

# Las variables de Neon van en .env.neon (`neon env pull --file .env.neon`), no aquí.
# Opcional: cadena DIRECTA de Neon (sin -pooler) para `npm run db:neon` si no usas .env.neon
NEON_DATABASE_URL=

JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
PORT=3000
# Clave con la que n8n envía los precios a /products/import (y lee /scraping/jobs).
# docker-compose la pasa también al contenedor de n8n. En GitHub Actions es el secreto FITOPRICE_API_KEY.
SCRAPER_API_KEY=cambia-esto-por-otra-cadena-aleatoria-larga

# Webs que pueden llamar a la API (separadas por comas). Sin definir: localhost:5173 y fitoprice.netlify.app
CORS_ORIGINS=http://localhost:5173

# --- Fotos en Cloudflare R2 (opcional en local) ---
# Sin estas variables las fotos se enlazan desde la web de cada tienda.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitoprice
# URL pública del bucket: https://pub-xxxx.r2.dev o un dominio propio, sin barra final
R2_PUBLIC_URL=
